# ---------------------------------------------------------------------------
# PrepGrade — environment variables (PLACEHOLDERS ONLY)
#
# Copy this file to `.env.local` for local development and fill in real values.
#   cp .env.example .env.local
#
# Rules:
#   - NEVER commit `.env.local` or any file containing real secrets.
#   - `NEXT_PUBLIC_*` variables are bundled into the browser and are PUBLIC.
#     Only place non-sensitive values behind that prefix.
#   - Everything else is SERVER-SIDE ONLY and must never be exposed to the client.
#   - The Supabase service-role key bypasses Row Level Security. Keep it strictly
#     server-side and use it only in trusted route handlers / server code.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# Public base URL of the app (used for auth callbacks, redirects, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database — PostgreSQL (SERVER-SIDE ONLY) ------------------------------
# Direct connection string for migrations / server-side data access.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Supabase (recommended MVP backend — see AGENTS.md §3) -----------------
# Project reference and URL are safe for the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anonymous key — safe for the browser; access is governed by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Service-role key — SERVER-SIDE ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Authentication (Supabase Auth — see AGENTS.md §3 and prompts/06) --------
# Sign-in/sign-up uses the public Supabase values above. Setup guide:
#   1. Auth → Providers → Email: enable. Set the redirect / Site URL to
#      ${NEXT_PUBLIC_APP_URL} and add ${NEXT_PUBLIC_APP_URL}/auth/callback as an
#      allowed redirect URL (used for confirmation and password-reset links).
#   2. Auth → Providers → Google (optional, for "Continue with Google"): create a
#      Google OAuth client, then paste its Client ID and Client Secret here and
#      in the Supabase dashboard. Authorised redirect URI:
#      https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
#   (Google credentials are stored in Supabase, NOT read by this app, so they
#    are intentionally not environment variables here.)

# --- Authentication (SERVER-SIDE ONLY) -------------------------------------
# Secret used to sign session / CSRF tokens. Generate a strong random value,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-strong-random-secret
